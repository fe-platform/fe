<file path=".github/workflows/ci.yml">
name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  packages:
    runs-on: ubuntu-latest
    name: Packages (typecheck)
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v1
        with:
          bun-version: latest
      - name: Cache Bun
        uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: bun-${{ hashFiles('**/bun.lock') }}
          restore-keys: bun-
      - name: Install
        run: bun install
      - name: Typecheck packages
        run: |
          bunx tsc --noEmit --project packages/core/tsconfig.json
          bunx tsc --noEmit --project packages/specifier/tsconfig.json
          bunx tsc --noEmit --project packages/cli/tsconfig.json
          bunx tsc --noEmit --project packages/runtime/tsconfig.json
          bunx tsc --noEmit --project packages/compiler/tsconfig.json
          bunx tsc --noEmit --project packages/jit-plugin-react/tsconfig.json
          bunx tsc --noEmit --project packages/jit-plugin-solid/tsconfig.json
  sandbox:
    runs-on: ubuntu-latest
    name: Sandbox (typecheck + build)
    needs: packages
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v1
        with:
          bun-version: latest
      - name: Cache Bun
        uses: actions/cache@v4
        with:
          path: ~/.bun/install/cache
          key: bun-${{ hashFiles('**/bun.lock') }}
          restore-keys: bun-
      - name: Install
        run: bun install
      - name: Typecheck sandbox
        run: |
          bunx tsc --noEmit --project sandbox/mfe-a/tsconfig.json
          bunx tsc --noEmit --project sandbox/mfe-b/tsconfig.json
          bunx tsc --noEmit --project sandbox/host-app/tsconfig.json
          bunx tsc --noEmit --project toolkit/devtools/tsconfig.json
      - name: Build sandbox
        run: |
          (cd sandbox/mfe-a && bun run check)
          (cd sandbox/mfe-b && bun run check)
          (cd toolkit/devtools && bun run check)
          (cd sandbox/host-app && bun run check)
</file>

