        <script type="module">
            import "@feo/fe-web-components";
            import "@feo/fe-syntax-highlighter";
            function getTarget(root, id) {
                const el = root.querySelector?.('[id="' + id + '"]');
                if (el) return el;
                for (const inc of root.querySelectorAll?.("html-include") || []) {
                    const found = getTarget(inc, id);
                    if (found) return found;
                }
                return null;
            }
            function sync() {
                const id = window.location.hash.slice(1);
                const target = getTarget(document, id);
                if (target && target.tagName === "DETAILS") {
                    let current = target;
                    while (current) { if (current.tagName === "DETAILS") current.open = true; current = current.parentElement; }
                    document.getElementById("main-content")?.scrollIntoView();
                }
            }
            window.addEventListener("hashchange", sync);
            // Trigger sync when fragments are loaded
            document.body.addEventListener("fragments-ready", sync);
            // Also handle individual fragment loads for non-eager ones
            document.body.addEventListener("load", (e) => {
                if (e.target.tagName === "HTML-INCLUDE" && window.location.hash) {
                    setTimeout(sync, 10);
                }
            });
        </script>
