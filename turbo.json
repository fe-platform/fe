{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**/*",
				"!../../core/plugin/src/**/*",
				"!../../create-fe-platform/src/**/*",
				"../../core/plugin/dist/**/*",
				"../../create-fe-platform/dist/**/*"
			],
			"outputs": ["dist/**", "build/**"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": ["**/.tsbuildinfo"]
		},
		"lint": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"cache": false
		}
	}
}
