{
  "name": "@feo/fe-web-components",
  "version": "0.2.0",
  "description": "Zero-dependency web components for fragment-based page assembly: html-include, fe-component, fe-compose.",
  "license": "MIT",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "exports": {
    ".": "./src/index.ts",
    "./html-include": "./src/html-include.ts",
    "./fe-component": "./src/fe-component.ts",
    "./fe-compose": "./src/fe-compose.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "jsr.json",
      "LICENSE"
    ]
  }
}
