{
  "name": "@fe-platform/syntax-highlighter",
  "version": "0.0.6",
  "description": "High-performance syntax highlighter using the CSS Custom Highlight API. Zero-DOM overhead, modular, and supporting TypeScript, JSON, and Shell.",
  "license": "MIT",
  "exports": {
    ".": "./src/core.ts",
    "./languages/ts": "./src/languages/ts.ts",
    "./languages/json": "./src/languages/json.ts",
    "./languages/shell": "./src/languages/shell.ts",
    "./themes/auto": "./src/themes/default.ts",
    "./themes/light": "./src/themes/light.ts",
    "./themes/dark": "./src/themes/dark.ts",
    "./themes/dracula": "./src/themes/dracula.ts",
    "./themes/github-light": "./src/themes/github-light.ts",
    "./types": "./src/types.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "jsr.json",
      "LICENSE"
    ]
  },
  "runtime": {
    "browser": true,
    "deno": true,
    "bun": true
  }
}
