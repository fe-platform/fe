{
  "name": "@feo/fe-syntax-highlighter",
  "version": "0.2.0",
  "description": "High-performance syntax highlighter using the CSS Custom Highlight API. Zero-DOM overhead, modular, and supporting TypeScript, JSON, Shell, and HTML. Auto-observes the DOM — import and done.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/observe.ts",
    "./core": "./src/core.ts",
    "./languages/ts": "./src/languages/ts.ts",
    "./languages/json": "./src/languages/json.ts",
    "./languages/shell": "./src/languages/shell.ts",
    "./languages/html": "./src/languages/html.ts",
    "./themes/auto": "./src/themes/default.ts",
    "./themes/light": "./src/themes/light.ts",
    "./themes/dark": "./src/themes/dark.ts",
    "./themes/dracula": "./src/themes/dracula.ts",
    "./themes/github-light": "./src/themes/github-light.ts",
    "./types": "./src/types.ts"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
